# PROBE (measurement only, never a final candidate): copied to ./Dockerfile in a probe
# commit, then reverted. A = the pipeline built with PGO, B = the same source without it,
# each built exactly as in its own scored Dockerfile (same paths, so same bytes).
# The published run time is about AB_BASE + AB_SCALE x (best A - best B) + fixed cost.
FROM rust:1.100.0-alpine AS base
RUN apk add --no-cache musl-dev
WORKDIR /src
COPY express/Cargo.toml express/Cargo.lock ./
COPY express/.cargo .cargo
COPY express/src src

FROM base AS a
COPY express/pgo pgo
RUN cargo rustc --release --target x86_64-unknown-linux-musl -- -Cprofile-use=/src/pgo/merged.profdata \
 && cp target/x86_64-unknown-linux-musl/release/pipeline /pipeline

FROM base AS b
RUN cargo build --release --target x86_64-unknown-linux-musl \
 && cp target/x86_64-unknown-linux-musl/release/pipeline /pipeline

FROM base AS probe
WORKDIR /probe
COPY probe/Cargo.toml ./
COPY probe/src src
RUN cargo build --release --target x86_64-unknown-linux-musl \
 && cp target/x86_64-unknown-linux-musl/release/ab-probe /ab-probe

FROM scratch
COPY --from=a /pipeline /pipeline-a
COPY --from=b /pipeline /pipeline-b
COPY --from=probe /ab-probe /probe
USER 1000:1000
CMD ["/probe"]
